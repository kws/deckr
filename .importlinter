[importlinter]
root_packages =
    deckr

include_external_packages = True

[importlinter:contract:core_must_not_import_hardware]
name = Core must not import hardware
type = forbidden
source_modules =
    deckr.core
forbidden_modules =
    deckr.hardware

[importlinter:contract:core_must_not_import_actions]
name = Core must not import action APIs
type = forbidden
source_modules =
    deckr.core
forbidden_modules =
    deckr.actions

[importlinter:contract:contracts_must_not_import_actions_or_hardware]
name = Contracts must not import action or hardware APIs
type = forbidden
source_modules =
    deckr.contracts
forbidden_modules =
    deckr.actions
    deckr.hardware

[importlinter:contract:runtime_must_not_import_services]
name = Runtime must not import service APIs
type = forbidden
source_modules =
    deckr.runtime
forbidden_modules =
    deckr.services
ignore_imports =
    deckr.runtime -> deckr.services
allow_indirect_imports = True

[importlinter:contract:hardware_must_not_import_actions]
name = Hardware must not import action APIs
type = forbidden
source_modules =
    deckr.hardware
forbidden_modules =
    deckr.actions
