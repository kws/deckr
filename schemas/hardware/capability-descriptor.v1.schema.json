{
  "$defs": {
    "CapabilityConstraint": {
      "additionalProperties": false,
      "description": "A typed generic constraint on a capability value or command parameter.",
      "properties": {
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "type",
        "subject"
      ],
      "title": "CapabilityConstraint",
      "type": "object"
    },
    "CapabilityProjection": {
      "additionalProperties": false,
      "description": "Explicit projection or derivation metadata for a capability.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "owner": {
          "enum": [
            "hardware_manager",
            "driver",
            "adapter",
            "component"
          ],
          "title": "Owner",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "type": {
          "default": "projection",
          "enum": [
            "projection",
            "derivation"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "source"
      ],
      "title": "CapabilityProjection",
      "type": "object"
    },
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Reference to a device-level or control-level capability.",
      "properties": {
        "capabilityId": {
          "title": "Capabilityid",
          "type": "string"
        },
        "controlId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Controlid"
        },
        "deviceRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "capabilityId"
      ],
      "title": "CapabilityRef",
      "type": "object"
    },
    "CapabilitySchema": {
      "additionalProperties": false,
      "description": "A JSON Schema fragment carried by a capability descriptor.",
      "properties": {
        "schema": {
          "additionalProperties": true,
          "title": "Schema",
          "type": "object"
        },
        "schemaId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schemaid"
        }
      },
      "required": [
        "schema"
      ],
      "title": "CapabilitySchema",
      "type": "object"
    },
    "CapabilityUnit": {
      "additionalProperties": false,
      "description": "Unit metadata for a capability field.",
      "properties": {
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "unit"
      ],
      "title": "CapabilityUnit",
      "type": "object"
    },
    "DeviceRef": {
      "additionalProperties": false,
      "description": "Reference to a manager-local device in a hardware manager context.",
      "properties": {
        "deviceId": {
          "title": "Deviceid",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "managerId": {
          "title": "Managerid",
          "type": "string"
        }
      },
      "required": [
        "managerId",
        "deviceId"
      ],
      "title": "DeviceRef",
      "type": "object"
    },
    "DeviceSourceReference": {
      "additionalProperties": false,
      "description": "Diagnostic reference to a source descriptor, report, layout, or protocol fact.",
      "properties": {
        "connectionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connectionid"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Facts",
          "type": "object"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "type"
      ],
      "title": "DeviceSourceReference",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "deckr.hardware.capability_descriptor.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Descriptor for one input, output, state, or command capability.",
  "properties": {
    "access": {
      "items": {
        "enum": [
          "emits",
          "readable",
          "settable",
          "requestable",
          "invokable"
        ],
        "type": "string"
      },
      "title": "Access",
      "type": "array"
    },
    "capabilityId": {
      "title": "Capabilityid",
      "type": "string"
    },
    "commandSchema": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilitySchema"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "commandTypes": {
      "items": {
        "type": "string"
      },
      "title": "Commandtypes",
      "type": "array"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/CapabilityConstraint"
      },
      "title": "Constraints",
      "type": "array"
    },
    "direction": {
      "enum": [
        "input",
        "output",
        "state",
        "command"
      ],
      "title": "Direction",
      "type": "string"
    },
    "eventTypes": {
      "items": {
        "type": "string"
      },
      "title": "Eventtypes",
      "type": "array"
    },
    "family": {
      "anyOf": [
        {
          "enum": [
            "deckr.device.power",
            "deckr.input.button",
            "deckr.input.encoder",
            "deckr.input.touch",
            "deckr.output.raster"
          ]
        },
        {
          "pattern": "^(?!deckr\\.)[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$",
          "type": "string"
        }
      ],
      "description": "Deckr-owned families must be one of the v1 core families; extension families must be globally namespaced and must not use the deckr. namespace.",
      "title": "Family"
    },
    "projection": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilityProjection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/DeviceSourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "type": {
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
      "title": "Type",
      "type": "string"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/CapabilityUnit"
      },
      "title": "Units",
      "type": "array"
    },
    "valueSchema": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilitySchema"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "capabilityId",
    "family",
    "type",
    "direction",
    "access"
  ],
  "title": "Deckr CapabilityDescriptor",
  "type": "object",
  "x-deckr-schema-version": "1"
}
