[importlinter]
root_packages =
    deckr

include_external_packages = True

[importlinter:contract:contracts_must_not_import_actions_or_hardware]
name = Contracts must not import action or hardware APIs
type = forbidden
source_modules =
    deckr.contracts
forbidden_modules =
    deckr.actions
    deckr.hardware

[importlinter:contract:state_must_not_import_actions]
name = State must not import action APIs
type = forbidden
source_modules =
    deckr.state
forbidden_modules =
    deckr.actions

[importlinter:contract:hardware_must_not_import_actions]
name = Hardware must not import action APIs
type = forbidden
source_modules =
    deckr.hardware
forbidden_modules =
    deckr.actions

[importlinter:contract:core_package_must_not_import_python_runtime]
name = Deckr core package must not import Python runtime support
type = forbidden
source_modules =
    deckr
forbidden_modules =
    anyio
    click
    nats
    deckr_nats_server_bin
    deckr_python_runtime
