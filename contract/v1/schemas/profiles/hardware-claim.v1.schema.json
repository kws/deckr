{
  "$defs": {
    "DeviceRef": {
      "additionalProperties": false,
      "description": "Reference to a manager-local device in a hardware manager context.",
      "properties": {
        "deviceId": {
          "title": "Deviceid",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "managerId": {
          "title": "Managerid",
          "type": "string"
        }
      },
      "required": [
        "managerId",
        "deviceId"
      ],
      "title": "DeviceRef",
      "type": "object"
    },
    "EndpointAddress": {
      "description": "A typed Deckr endpoint address serialized as ``<family>:<endpoint_id>``.",
      "title": "EndpointAddress",
      "type": "string"
    },
    "HardwareClaimDevice": {
      "additionalProperties": false,
      "properties": {
        "deviceRef": {
          "$ref": "#/$defs/DeviceRef"
        },
        "instanceCount": {
          "title": "Instancecount",
          "type": "integer"
        }
      },
      "required": [
        "deviceRef",
        "instanceCount"
      ],
      "title": "HardwareClaimDevice",
      "type": "object"
    }
  },
  "$id": "dev.deckr.profile.hardware_claim.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimId": {
      "title": "Claimid",
      "type": "string"
    },
    "controllerEndpoint": {
      "$ref": "#/$defs/EndpointAddress"
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/HardwareClaimDevice"
      },
      "title": "Devices",
      "type": "array"
    },
    "managerAdvertisementId": {
      "title": "Manageradvertisementid",
      "type": "string"
    },
    "managerEndpoint": {
      "$ref": "#/$defs/EndpointAddress"
    },
    "profile": {
      "const": "dev.deckr.profile.hardware_claim.v1",
      "default": "dev.deckr.profile.hardware_claim.v1",
      "title": "Profile",
      "type": "string"
    }
  },
  "required": [
    "claimId",
    "controllerEndpoint",
    "managerEndpoint",
    "managerAdvertisementId",
    "devices"
  ],
  "title": "Deckr Concord hardware claim terms",
  "type": "object",
  "x-deckr-schema-version": "1"
}
