{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/protocols/concord/token-cleanup.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable ownership of post-contract participant-token cleanup.",
  "properties": {
    "cleanupStartedAt": {
      "format": "date-time",
      "title": "Cleanupstartedat",
      "type": "string"
    },
    "contractId": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "title": "Contractid",
      "type": "string"
    },
    "contractRevision": {
      "minimum": 0,
      "title": "Contractrevision",
      "type": "integer"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "schema": {
      "const": "dev.deckr.concord.token-cleanup.v1",
      "default": "dev.deckr.concord.token-cleanup.v1",
      "title": "Schema",
      "type": "string"
    },
    "termsHash": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Termshash"
    }
  },
  "required": [
    "contractId",
    "generation",
    "contractRevision",
    "cleanupStartedAt"
  ],
  "title": "ConcordTokenCleanupRecord",
  "type": "object"
}
