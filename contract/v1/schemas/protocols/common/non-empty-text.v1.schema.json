{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Nonempty Unicode text without leading or trailing whitespace. No coercion or trimming.",
  "minLength": 1,
  "not": {
    "pattern": "^\\s|\\s$"
  },
  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
  "title": "Non-empty text",
  "type": "string"
}
