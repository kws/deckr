{
  "$defs": {
    "EndpointAddress": {
      "description": "A typed Deckr endpoint address serialized as ``<family>:<endpoint_id>``.",
      "title": "EndpointAddress",
      "type": "string"
    },
    "JsonValue": {},
    "ServiceStatusValue": {
      "enum": [
        "available",
        "degraded",
        "unavailable"
      ],
      "title": "ServiceStatusValue",
      "type": "string"
    }
  },
  "$id": "dev.deckr.state.service_status.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Diagnostics",
      "type": "object"
    },
    "serviceEndpoint": {
      "$ref": "#/$defs/EndpointAddress"
    },
    "serviceId": {
      "title": "Serviceid",
      "type": "string"
    },
    "serviceNamespace": {
      "title": "Servicenamespace",
      "type": "string"
    },
    "sessionId": {
      "title": "Sessionid",
      "type": "string"
    },
    "status": {
