{
  "$defs": {
    "EndpointAddress": {
      "description": "A typed Deckr endpoint address serialized as ``<family>:<endpoint_id>``.",
      "pattern": "^(?:action_provider:[A-Za-z0-9][A-Za-z0-9._-]*|(?:controller|hardware_manager|service):[^:\\s](?:[^:]*[^:\\s])?)$",
      "title": "EndpointAddress",
      "type": "string"
    },
    "JsonValue": {},
    "ServiceStatusValue": {
      "enum": [
        "available",
        "degraded",
        "unavailable"
      ],
      "title": "ServiceStatusValue",
      "type": "string"
    }
  },
  "$id": "dev.deckr.state.service_status.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Current-state payload publishing the current availability state and diagnostics for one service endpoint.",
  "properties": {
    "diagnostics": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Diagnostics",
      "type": "object"
    },
    "serviceEndpoint": {
      "$ref": "#/$defs/EndpointAddress"
    },
    "serviceId": {
      "title": "Serviceid",
      "type": "string"
    },
    "serviceNamespace": {
      "title": "Servicenamespace",
      "type": "string"
    },
    "sessionId": {
      "title": "Sessionid",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ServiceStatusValue",
      "description": "Case-sensitive service availability value.",
      "examples": [
        "available",
        "degraded",
        "unavailable"
      ]
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "serviceId",
    "serviceEndpoint",
    "serviceNamespace",
    "sessionId",
    "status",
    "timestamp"
  ],
  "title": "Service status state",
  "type": "object",
  "x-deckr-example-fixtures": [
    "fixtures/valid/state/service-status.v1.json"
  ],
  "x-deckr-schema-version": "1",
  "x-deckr-surface": "state.kv"
}
