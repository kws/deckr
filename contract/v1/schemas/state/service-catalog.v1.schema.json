{
  "$defs": {
    "EndpointAddress": {
      "description": "A typed Deckr endpoint address serialized as ``<family>:<endpoint_id>``.",
      "pattern": "^(?:action_provider:[A-Za-z0-9][A-Za-z0-9._-]*|(?:controller|hardware_manager|service):[^:\\s](?:[^:]*[^:\\s])?)$",
      "title": "EndpointAddress",
      "type": "string"
    },
    "JsonValue": {}
  },
  "$id": "dev.deckr.state.service_catalog.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Current-state payload advertising one service endpoint's namespace, supported operations, and view key prefixes.",
  "properties": {
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Annotations",
      "type": "object"
    },
    "diagnostics": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Diagnostics",
      "type": "object"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "serviceEndpoint": {
      "$ref": "#/$defs/EndpointAddress"
    },
    "serviceId": {
      "description": "Service endpoint id that owns this catalog.",
      "examples": [
        "media-home"
      ],
      "title": "Serviceid",
      "type": "string"
    },
    "serviceNamespace": {
      "title": "Servicenamespace",
      "type": "string"
    },
    "sessionId": {
      "title": "Sessionid",
      "type": "string"
    },
    "supportedOperations": {
      "items": {
        "type": "string"
      },
      "title": "Supportedoperations",
      "type": "array"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "viewPrefixes": {
      "items": {
        "type": "string"
      },
      "title": "Viewprefixes",
      "type": "array"
    }
  },
  "required": [
    "serviceId",
    "serviceEndpoint",
    "serviceNamespace",
    "sessionId",
    "timestamp"
  ],
  "title": "Service catalog state",
  "type": "object",
  "x-deckr-example-fixtures": [
    "fixtures/valid/state/service-catalog.v1.json"
  ],
  "x-deckr-schema-version": "1",
  "x-deckr-surface": "state.kv"
}
