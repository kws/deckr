{
  "$defs": {
    "EndpointAddress": {
      "description": "A typed Deckr endpoint address serialized as ``<family>:<endpoint_id>``.",
      "pattern": "^(?:action_provider:[A-Za-z0-9][A-Za-z0-9._-]*|(?:controller|hardware_manager|service):[^:\\s](?:[^:]*[^:\\s])?)$",
      "title": "EndpointAddress",
      "type": "string"
    }
  },
  "$id": "dev.deckr.state.device_claim.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Current-state payload representing a controller claim on a device. The claim uses endpoint and session identity rather than process-local runtime ids.",
  "properties": {
    "claimedByEndpoint": {
      "$ref": "#/$defs/EndpointAddress",
      "description": "Controller endpoint address that currently owns the claim.",
      "examples": [
        "controller:controller-main"
      ]
    },
    "claimedBySessionId": {
      "title": "Claimedbysessionid",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "ttlSeconds": {
      "title": "Ttlseconds",
      "type": "integer"
    }
  },
  "required": [
    "claimedByEndpoint",
    "claimedBySessionId",
    "timestamp",
    "ttlSeconds"
  ],
  "title": "Device claim state",
  "type": "object",
  "x-deckr-example-fixtures": [
    "fixtures/valid/state/device-claim.v1.json"
  ],
  "x-deckr-schema-version": "1",
  "x-deckr-surface": "state.kv"
}
