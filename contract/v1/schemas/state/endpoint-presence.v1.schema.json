{
  "$defs": {
    "EndpointAddress": {
      "description": "A typed Deckr endpoint address serialized as ``<family>:<endpoint_id>``.",
      "pattern": "^(?:action_provider:[A-Za-z0-9][A-Za-z0-9._-]*|(?:controller|hardware_manager|service):[^:\\s](?:[^:]*[^:\\s])?)$",
      "title": "EndpointAddress",
      "type": "string"
    }
  },
  "$id": "dev.deckr.state.endpoint_presence.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Current-state payload advertising that an endpoint session is present on a lane. Presence uses contract endpoint addresses and lane names, not Python runtime component names.",
  "properties": {
    "endpoint": {
      "$ref": "#/$defs/EndpointAddress",
      "description": "Deckr endpoint address with shape '<family>:<endpoint-id>'. Endpoint families and ids are case-sensitive.",
      "examples": [
        "action_provider:clock-main",
        "controller:controller-main"
      ]
    },
    "lane": {
      "description": "Deckr lane name that this endpoint session is present on.",
      "examples": [
        "actions",
        "hardware_messages",
        "services"
      ],
      "title": "Lane",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metadata",
      "type": "object"
    },
    "sessionId": {
      "title": "Sessionid",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "ttlSeconds": {
      "title": "Ttlseconds",
      "type": "integer"
    }
  },
  "required": [
    "endpoint",
    "lane",
    "sessionId",
    "timestamp",
    "ttlSeconds"
  ],
  "title": "Endpoint presence state",
  "type": "object",
  "x-deckr-example-fixtures": [
    "fixtures/valid/state/endpoint-presence.v1.json"
  ],
  "x-deckr-schema-version": "1",
  "x-deckr-surface": "state.kv"
}
