{
  "$defs": {
    "BroadcastTarget": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "endpointFamily": {
          "title": "Endpointfamily",
          "type": "string"
        },
        "hopLimit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hoplimit"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "targetType": {
          "const": "broadcast",
          "default": "broadcast",
          "title": "Targettype",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "endpointFamily"
      ],
      "title": "BroadcastTarget",
      "type": "object"
    },
    "DeckrMessage": {
      "additionalProperties": false,
      "description": "Transport-neutral Deckr logical message envelope.",
      "properties": {
        "body": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Body",
          "type": "object"
        },
        "causationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causationid"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "expiresAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiresat"
        },
        "inReplyTo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inreplyto"
        },
        "lane": {
          "title": "Lane",
          "type": "string"
        },
        "messageId": {
          "title": "Messageid",
          "type": "string"
        },
        "messageType": {
          "title": "Messagetype",
          "type": "string"
        },
        "protocolVersion": {
          "const": "1",
          "default": "1",
          "title": "Protocolversion",
          "type": "string"
        },
        "recipient": {
          "discriminator": {
            "mapping": {
              "broadcast": "#/$defs/BroadcastTarget",
              "endpoint": "#/$defs/EndpointTarget"
            },
            "propertyName": "targetType"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EndpointTarget"
            },
            {
              "$ref": "#/$defs/BroadcastTarget"
            }
          ],
          "title": "Recipient"
        },
        "recipientSessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipientsessionid"
        },
        "schemaVersion": {
          "default": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/EndpointAddress"
        },
        "senderSessionId": {
          "title": "Sendersessionid",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/EntitySubject"
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ttlMs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttlms"
        }
      },
      "required": [
        "lane",
        "messageType",
        "sender",
        "senderSessionId",
        "recipient",
        "subject",
        "body"
      ],
      "title": "DeckrMessage",
      "type": "object"
    },
    "EndpointAddress": {
      "description": "A typed Deckr endpoint address serialized as ``<family>:<endpoint_id>``.",
      "pattern": "^(?:action_provider:[A-Za-z0-9][A-Za-z0-9._-]*|(?:controller|hardware_manager|service):[^:\\s](?:[^:]*[^:\\s])?)$",
      "title": "EndpointAddress",
      "type": "string"
    },
    "EndpointTarget": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/EndpointAddress"
        },
        "targetType": {
          "const": "endpoint",
          "default": "endpoint",
          "title": "Targettype",
          "type": "string"
        }
      },
      "required": [
        "endpoint"
      ],
      "title": "EndpointTarget",
      "type": "object"
    },
    "EntitySubject": {
      "additionalProperties": false,
      "properties": {
        "identifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "object"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EntitySubject",
      "type": "object"
    },
    "JsonValue": {},
    "ServiceCommandBody": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Params",
          "type": "object"
        },
        "serviceNamespace": {
          "title": "Servicenamespace",
          "type": "string"
        }
      },
      "required": [
        "serviceNamespace",
        "operation"
      ],
      "title": "ServiceCommandBody",
      "type": "object"
    },
    "ServiceCommandReplyBody": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "result": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Result",
          "type": "object"
        },
        "serviceNamespace": {
          "title": "Servicenamespace",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ServiceCommandStatus"
        }
      },
      "required": [
        "serviceNamespace",
        "operation",
        "status"
      ],
      "title": "ServiceCommandReplyBody",
      "type": "object"
    },
    "ServiceCommandStatus": {
      "enum": [
        "ok",
        "rejected",
        "unavailable",
        "error"
      ],
      "title": "ServiceCommandStatus",
      "type": "string"
    },
    "ServiceError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "diagnostics": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Diagnostics",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ServiceError",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "properties": {
        "traceParent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        },
        "traceState": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracestate"
        }
      },
      "title": "TraceContext",
      "type": "object"
    }
  },
  "$id": "dev.deckr.message.services.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Envelope schema for all messages carried on the Deckr services lane. Service endpoints use these messages for endpoint-addressed commands and replies without becoming injected Python objects.",
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "#/$defs/DeckrMessage"
        },
        {
          "properties": {
            "body": {
              "$ref": "#/$defs/ServiceCommandBody"
            },
            "lane": {
              "const": "services"
            },
            "messageType": {
              "const": "serviceCommand"
            }
          },
          "required": [
            "lane",
            "messageType",
            "body"
          ],
          "type": "object"
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/DeckrMessage"
        },
        {
          "properties": {
            "body": {
              "$ref": "#/$defs/ServiceCommandReplyBody"
            },
            "lane": {
              "const": "services"
            },
            "messageType": {
              "const": "serviceCommandReply"
            }
          },
          "required": [
            "lane",
            "messageType",
            "body"
          ],
          "type": "object"
        }
      ]
    }
  ],
  "title": "Deckr services Lane Message",
  "x-deckr-example-fixtures": [
    "fixtures/valid/services/service-command.v1.json",
    "fixtures/valid/services/service-command-reply.v1.json"
  ],
  "x-deckr-schema-version": "1",
  "x-deckr-surface": "messages.services"
}
