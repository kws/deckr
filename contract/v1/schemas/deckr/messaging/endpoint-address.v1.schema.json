{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/messaging/endpoint-address.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/endpoint-address.v1.schema.json"
    },
    {
      "pattern": "^(controller|hardware_manager|action_provider|service):"
    },
    {
      "if": {
        "pattern": "^action_provider:"
      },
      "then": {
        "not": {
          "const": "action_provider:dev.deckr.controller.builtin"
        },
        "pattern": "^action_provider:[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    }
  ],
  "title": "Deckr endpoint address"
}
