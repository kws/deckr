{
  "$defs": {
    "ServiceExchangePattern": {
      "enum": [
        "one_way",
        "request_reply"
      ],
      "title": "ServiceExchangePattern",
      "type": "string"
    },
    "ServiceMessageDirection": {
      "enum": [
        "consumer_to_service",
        "service_to_consumer",
        "bidirectional"
      ],
      "title": "ServiceMessageDirection",
      "type": "string"
    },
    "ServiceMessageIntent": {
      "enum": [
        "command",
        "query",
        "event",
        "notification"
      ],
      "title": "ServiceMessageIntent",
      "type": "string"
    }
  },
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/services/service-message-definition.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "direction": {
                "enum": [
                  "consumer_to_service",
                  "bidirectional"
                ]
              }
            },
            "required": [
              "direction"
            ]
          },
          {
            "properties": {
              "intent": {
                "enum": [
                  "command",
                  "query"
                ]
              }
            },
            "required": [
              "intent"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "operation"
        ]
      }
    }
  ],
  "properties": {
    "direction": {
      "$ref": "#/$defs/ServiceMessageDirection"
    },
    "errorSchema": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/services/service-payload-schema.v1.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "eventSchema": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/services/service-payload-schema.v1.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exchangePattern": {
      "$ref": "#/$defs/ServiceExchangePattern"
    },
    "intent": {
      "$ref": "#/$defs/ServiceMessageIntent"
    },
    "operation": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation"
    },
    "paramsSchema": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/services/service-payload-schema.v1.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resultSchema": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/services/service-payload-schema.v1.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "intent",
    "exchangePattern",
    "direction"
  ],
  "title": "ServiceMessageDefinition",
  "type": "object"
}
