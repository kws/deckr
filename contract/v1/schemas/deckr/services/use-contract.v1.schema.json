{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/services/use-contract.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/messaging/contract.v1.schema.json"
    },
    {
      "properties": {
        "participants": {
          "contains": {
            "pattern": "^service:"
          },
          "maxItems": 2,
          "minContains": 1,
          "minItems": 2
        },
        "profile": {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json"
        },
        "terms": false,
        "termsHash": false
      },
      "required": [
        "profile"
      ]
    }
  ],
  "title": "Service-use contract"
}
