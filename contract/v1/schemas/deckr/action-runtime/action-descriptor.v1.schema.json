{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/action-runtime/action-descriptor.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Action identity advertised by an action provider.",
  "properties": {
    "actionId": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "title": "Actionid",
      "type": "string"
    },
    "controllers": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Controllers"
    },
    "manifestDefaults": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/json-value.v1.schema.json"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifestdefaults"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "propertyInspectorPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Propertyinspectorpath"
    },
    "providerId": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Providerid"
    },
    "providerSettingsSchema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/json-value.v1.schema.json"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Providersettingsschema"
    },
    "requirements": {
      "anyOf": [
        {
          "items": {
            "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/action-runtime/capability-requirement.v1.schema.json"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Absent, null, and an empty array all declare no capability requirements and produce no matched capabilities.",
      "title": "Requirements"
    },
    "settingsSchema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/json-value.v1.schema.json"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Settingsschema"
    }
  },
  "required": [
    "actionId"
  ],
  "title": "ActionDescriptor",
  "type": "object"
}
