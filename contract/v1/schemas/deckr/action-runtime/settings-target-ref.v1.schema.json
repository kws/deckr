{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/action-runtime/settings-target-ref.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "action_provider_instance"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "actionId": {
            "type": "null"
          },
          "actionInstanceId": {
            "type": "null"
          },
          "stableId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "action_instance"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "actionId": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "actionId"
            ]
          },
          {
            "properties": {
              "actionInstanceId": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "actionInstanceId"
            ]
          }
        ]
      }
    }
  ],
  "description": "Durable settings identity independent of live context or binding handles.",
  "properties": {
    "actionId": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actionid"
    },
    "actionInstanceId": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actioninstanceid"
    },
    "configId": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "title": "Configid",
      "type": "string"
    },
    "controllerId": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "title": "Controllerid",
      "type": "string"
    },
    "providerId": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "title": "Providerid",
      "type": "string"
    },
    "providerInstanceId": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Providerinstanceid",
      "type": "string"
    },
    "scope": {
      "enum": [
        "action_provider_instance",
        "action_instance"
      ],
      "title": "Scope",
      "type": "string"
    },
    "stableId": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stableid"
    }
  },
  "required": [
    "scope",
    "controllerId",
    "configId",
    "providerInstanceId",
    "providerId"
  ],
  "title": "SettingsTargetRef",
  "type": "object"
}
