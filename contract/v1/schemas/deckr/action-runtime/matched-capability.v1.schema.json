{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/action-runtime/matched-capability.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A capability selected by the controller for a binding requirement.",
  "properties": {
    "capability": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/hardware/capability-ref.v1.schema.json",
      "properties": {
        "controlId": {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json"
        },
        "deviceRef": {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/hardware/device-ref.v1.schema.json"
        }
      },
      "required": [
        "deviceRef",
        "controlId"
      ]
    },
    "commandTypes": {
      "description": "The complete supported name set from the selected descriptor; order has no meaning.",
      "items": {
        "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
        "type": "string"
      },
      "title": "Commandtypes",
      "type": "array",
      "uniqueItems": true
    },
    "direction": {
      "enum": [
        "input",
        "output",
        "state",
        "command"
      ],
      "title": "Direction",
      "type": "string"
    },
    "eventTypes": {
      "description": "The complete supported name set from the selected descriptor; order has no meaning.",
      "items": {
        "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
        "type": "string"
      },
      "title": "Eventtypes",
      "type": "array",
      "uniqueItems": true
    },
    "family": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "anyOf": [
            {
              "enum": [
                "dev.deckr.device.power",
                "dev.deckr.input.button",
                "dev.deckr.input.encoder",
                "dev.deckr.input.touch",
                "dev.deckr.output.raster"
              ]
            },
            {
              "pattern": "^(?!dev\\.deckr\\.)[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$",
              "type": "string"
            }
          ],
          "enum": [
            "dev.deckr.device.power",
            "dev.deckr.input.button",
            "dev.deckr.input.encoder",
            "dev.deckr.input.touch",
            "dev.deckr.output.raster"
          ]
        },
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "anyOf": [
            {
              "enum": [
                "dev.deckr.device.power",
                "dev.deckr.input.button",
                "dev.deckr.input.encoder",
                "dev.deckr.input.touch",
                "dev.deckr.output.raster"
              ]
            },
            {
              "pattern": "^(?!dev\\.deckr\\.)[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$",
              "type": "string"
            }
          ],
          "pattern": "^(?!dev\\.deckr\\.)[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$",
          "type": "string"
        }
      ],
      "title": "Family",
      "type": "string"
    },
    "provenance": {
      "default": "native",
      "description": "Use projection or derivation when projection metadata exists. Otherwise use native for a core family and extension for an extension family.",
      "enum": [
        "native",
        "projection",
        "derivation",
        "extension"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "requirementName": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "description": "The unique declared requirement satisfied by this match."
    },
    "source": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/hardware/capability-ref.v1.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "type": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "capability",
    "family",
    "type",
    "direction",
    "requirementName"
  ],
  "title": "MatchedCapability",
  "type": "object"
}
