{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/action-runtime/advertisement.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/services/advertisement.v1.schema.json"
    },
    {
      "properties": {
        "endpoint": {
          "pattern": "^service:action-runtime\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "featureId": {
          "const": "dev.deckr.action_runtime.provider"
        },
        "payload": {
          "properties": {
            "profile": {
              "const": "dev.deckr.action_runtime.provider.advertisement.v1"
            },
            "serviceEndpoint": {
              "pattern": "^service:action-runtime\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "serviceId": {
              "pattern": "^action-runtime\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "serviceNamespace": {
              "const": "dev.deckr.action_runtime.provider"
            },
            "serviceUseProfile": {
              "const": "dev.deckr.action_runtime.provider.service_use.v1"
            }
          }
        }
      }
    }
  ],
  "title": "Action Runtime service advertisement"
}
