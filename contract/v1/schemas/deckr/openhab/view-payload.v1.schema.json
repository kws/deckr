{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/openhab/view-payload.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "item": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "oldState": {
      "type": "string"
    },
    "serviceId": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "serviceNamespace": {
      "const": "dev.deckr.openhab.service"
    },
    "sessionId": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "serviceId",
    "serviceNamespace",
    "sessionId",
    "timestamp",
    "item",
    "state",
    "source"
  ],
  "title": "openhab current resource payload",
  "type": "object"
}
