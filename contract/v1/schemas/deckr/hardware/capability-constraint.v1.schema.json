{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/hardware/capability-constraint.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "value": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "properties": {
            "minimum": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "minimum"
          ]
        },
        {
          "properties": {
            "maximum": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "maximum"
          ]
        },
        {
          "properties": {
            "step": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "step"
          ]
        },
        {
          "properties": {
            "values": {
              "minItems": 1
            }
          },
          "required": [
            "values"
          ]
        }
      ]
    }
  ],
  "description": "A typed generic constraint on a capability value or command parameter.",
  "properties": {
    "maximum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum"
    },
    "minimum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum"
    },
    "step": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step"
    },
    "subject": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
      "title": "Subject",
      "type": "string"
    },
    "type": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
      "title": "Type",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/json-value.v1.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "values": {
      "items": {
        "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/json-value.v1.schema.json"
      },
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "type",
    "subject"
  ],
  "title": "CapabilityConstraint",
  "type": "object"
}
