        "advertiser": {
          "pattern": "^hardware_manager:"
        },
        "endpoint": {
          "pattern": "^hardware_manager:"
        },
        "featureId": {
          "const": "dev.deckr.hardware"
        },
        "payload": {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/hardware/advertisement-payload.v1.schema.json"
