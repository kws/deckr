      "minLength": 1,
      "title": "Image",
      "type": "string"
    },
    "width": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Width"
    }
  },
  "required": [
    "image",
    "encoding"
  ],
  "title": "RasterBitmapSetFrameParams",
  "type": "object"
