      "enum": [
        "jpeg",
        "png"
      ],
      "title": "Encoding",
      "type": "string"
    },
    "height": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Height"
    },
    "image": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "contentEncoding": "base64",
