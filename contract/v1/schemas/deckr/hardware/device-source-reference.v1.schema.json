{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/hardware/device-source-reference.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Diagnostic reference to a source descriptor, report, layout, or protocol fact.",
  "properties": {
    "connectionId": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connectionid"
    },
    "facts": {
      "additionalProperties": {
        "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/json-value.v1.schema.json"
      },
      "title": "Facts",
      "type": "object"
    },
    "label": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "sourceId": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "not": {
        "pattern": "^(action_provider|controller|hardware_manager):"
      },
      "title": "Sourceid",
      "type": "string"
    },
    "type": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "sourceId",
    "type"
  ],
  "title": "DeviceSourceReference",
  "type": "object"
}
