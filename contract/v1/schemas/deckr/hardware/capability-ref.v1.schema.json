{
  "$id": "https://kws.github.io/deckr/contract/v1/schemas/deckr/hardware/capability-ref.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reference to a device-level or control-level capability.",
  "properties": {
    "capabilityId": {
      "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
      "title": "Capabilityid",
      "type": "string"
    },
    "controlId": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/protocols/common/non-empty-text.v1.schema.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Controlid"
    },
    "deviceRef": {
      "anyOf": [
        {
          "$ref": "https://kws.github.io/deckr/contract/v1/schemas/deckr/hardware/device-ref.v1.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "capabilityId"
  ],
  "title": "CapabilityRef",
  "type": "object"
}
