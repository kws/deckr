{
  "$defs": {
    "ContractPointer": {
      "additionalProperties": false,
      "properties": {
        "contractId": {
          "title": "Contractid",
          "type": "string"
        },
        "generation": {
          "title": "Generation",
          "type": "integer"
        }
      },
      "required": [
        "contractId",
        "generation"
      ],
      "title": "ContractPointer",
      "type": "object"
    },
    "ContractState": {
      "enum": [
        "open",
        "cancelled"
      ],
      "title": "ContractState",
      "type": "string"
    },
    "EndpointAddress": {
      "description": "A typed Deckr endpoint address serialized as ``<family>:<endpoint_id>``.",
      "title": "EndpointAddress",
      "type": "string"
    },
    "JsonValue": {}
  },
  "$id": "dev.deckr.concord.contract.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachedParticipants": {
      "items": {
        "$ref": "#/$defs/EndpointAddress"
      },
      "title": "Attachedparticipants",
      "type": "array"
    },
    "cancelReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelreason"
    },
    "cancelRevision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelrevision"
    },
    "cancelledAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelledat"
    },
    "cancelledBy": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndpointAddress"
        },
        {
          "const": "concord:maintenance",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelledby"
    },
    "contractId": {
      "title": "Contractid",
      "type": "string"
    },
    "createdAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Createdat"
    },
    "createdBy": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndpointAddress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generation": {
      "title": "Generation",
      "type": "integer"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/EndpointAddress"
      },
      "title": "Participants",
      "type": "array"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile"
    },
    "schema": {
      "const": "dev.deckr.concord.contract.v1",
      "default": "dev.deckr.concord.contract.v1",
      "title": "Schema",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ContractState",
      "default": "open"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContractPointer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "terms": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terms"
    },
    "termsHash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Termshash"
    }
  },
  "required": [
    "contractId",
    "generation",
    "participants",
    "attachedParticipants"
  ],
  "title": "Concord contract",
  "type": "object",
  "x-deckr-schema-version": "1"
}
