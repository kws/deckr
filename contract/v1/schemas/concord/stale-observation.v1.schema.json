{
  "$defs": {
    "ContractValidityStatus": {
      "enum": [
        "valid",
        "not_yet_fulfilled",
        "cancelled",
        "missing_contract",
        "invalid_contract",
        "invalid_token",
        "missing_token",
        "generation_mismatch",
        "session_mismatch",
        "terms_hash_mismatch",
        "unavailable"
      ],
      "title": "ContractValidityStatus",
      "type": "string"
    }
  },
  "$id": "dev.deckr.concord.stale-observation.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contractId": {
      "title": "Contractid",
      "type": "string"
    },
    "contractRevision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contractrevision"
    },
    "firstObservedStaleAt": {
      "format": "date-time",
      "title": "Firstobservedstaleat",
      "type": "string"
    },
    "generation": {
      "title": "Generation",
      "type": "integer"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "schema": {
      "const": "dev.deckr.concord.stale-observation.v1",
      "default": "dev.deckr.concord.stale-observation.v1",
      "title": "Schema",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ContractValidityStatus"
    }
  },
  "required": [
    "contractId",
    "generation",
    "firstObservedStaleAt",
    "status"
  ],
  "title": "Concord stale observation",
  "type": "object",
  "x-deckr-schema-version": "1"
}
