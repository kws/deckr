{
  "$defs": {
    "CapabilityConstraint": {
      "additionalProperties": false,
      "description": "A typed generic constraint on a capability value or command parameter.",
      "properties": {
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "type",
        "subject"
      ],
      "title": "CapabilityConstraint",
      "type": "object"
    },
    "CapabilityDescriptor": {
      "additionalProperties": false,
      "description": "Descriptor for one input, output, state, or command capability.",
      "properties": {
        "access": {
          "items": {
            "enum": [
              "emits",
              "readable",
              "settable",
              "requestable",
              "invokable"
            ],
            "type": "string"
          },
          "title": "Access",
          "type": "array"
        },
        "capabilityId": {
          "title": "Capabilityid",
          "type": "string"
        },
        "commandSchema": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilitySchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "commandTypes": {
          "items": {
            "type": "string"
          },
          "title": "Commandtypes",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/CapabilityConstraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "state",
            "command"
          ],
          "title": "Direction",
          "type": "string"
        },
        "eventTypes": {
          "items": {
            "type": "string"
          },
          "title": "Eventtypes",
          "type": "array"
        },
        "family": {
          "anyOf": [
            {
              "enum": [
                "dev.deckr.device.power",
                "dev.deckr.input.button",
                "dev.deckr.input.encoder",
                "dev.deckr.input.touch",
                "dev.deckr.output.raster"
              ]
            },
            {
              "pattern": "^(?!dev\\.deckr\\.)[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$",
              "type": "string"
            }
          ],
          "description": "Deckr-owned families must be one of the v1 core families; extension families must be globally namespaced and must not use the dev.deckr. namespace.",
          "title": "Family"
        },
        "projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityProjection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DeviceSourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$",
          "title": "Type",
          "type": "string"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/CapabilityUnit"
          },
          "title": "Units",
          "type": "array"
        },
        "valueSchema": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilitySchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "capabilityId",
        "family",
        "type",
        "direction",
        "access"
      ],
      "title": "CapabilityDescriptor",
      "type": "object"
    },
    "CapabilityProjection": {
      "additionalProperties": false,
      "description": "Explicit projection or derivation metadata for a capability.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "owner": {
          "enum": [
            "hardware_manager",
            "adapter",
            "component"
          ],
          "title": "Owner",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DescriptorCapabilityRef"
        },
        "type": {
          "default": "projection",
          "enum": [
            "projection",
            "derivation"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "source"
      ],
      "title": "CapabilityProjection",
      "type": "object"
    },
    "CapabilitySchema": {
      "additionalProperties": false,
      "description": "A JSON Schema fragment carried by a capability descriptor.",
      "properties": {
        "schema": {
          "additionalProperties": true,
          "title": "Schema",
          "type": "object"
        },
        "schemaId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schemaid"
        }
      },
      "required": [
        "schema"
      ],
      "title": "CapabilitySchema",
      "type": "object"
    },
    "CapabilityUnit": {
      "additionalProperties": false,
      "description": "Unit metadata for a capability field.",
      "properties": {
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "unit"
      ],
      "title": "CapabilityUnit",
      "type": "object"
    },
    "ControlDescriptor": {
      "additionalProperties": false,
      "description": "Descriptor for one addressable user-facing control or region.",
      "properties": {
        "configCapabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          },
          "title": "Configcapabilities",
          "type": "array"
        },
        "controlId": {
          "title": "Controlid",
          "type": "string"
        },
        "diagnosticCapabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          },
          "title": "Diagnosticcapabilities",
          "type": "array"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlGeometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "groupId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Groupid"
        },
        "inputCapabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          },
          "title": "Inputcapabilities",
          "type": "array"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "outputCapabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          },
          "title": "Outputcapabilities",
          "type": "array"
        },
        "parentControlId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parentcontrolid"
        },
        "relatedControlIds": {
          "items": {
            "type": "string"
          },
          "title": "Relatedcontrolids",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DeviceSourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "stateCapabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          },
          "title": "Statecapabilities",
          "type": "array"
        },
        "surfaceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surfaceid"
        }
      },
      "required": [
        "controlId",
        "kind"
      ],
      "title": "ControlDescriptor",
      "type": "object"
    },
    "ControlGeometry": {
      "additionalProperties": false,
      "description": "A control's placement on a logical or physical surface.",
      "properties": {
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "layer": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer"
        },
        "rotation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation"
        },
        "unit": {
          "default": "grid",
          "enum": [
            "grid",
            "pixel",
            "normalized",
            "millimeter"
          ],
          "title": "Unit",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "x": {
          "default": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "ControlGeometry",
      "type": "object"
    },
    "DescriptorCapabilityRef": {
      "additionalProperties": false,
      "description": "Reference to a capability owned by the enclosing ``DeviceDescriptor``.",
      "properties": {
        "capabilityId": {
          "title": "Capabilityid",
          "type": "string"
        },
        "controlId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Controlid"
        }
      },
      "required": [
        "capabilityId"
      ],
      "title": "DescriptorCapabilityRef",
      "type": "object"
    },
    "DeviceConnection": {
      "additionalProperties": false,
      "description": "Structured protocol or transport facts about a device connection.",
      "properties": {
        "connectionId": {
          "title": "Connectionid",
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Facts",
          "type": "object"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "status": {
          "default": "available",
          "enum": [
            "connected",
            "available",
            "unavailable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "transport": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "connectionId",
        "type"
      ],
      "title": "DeviceConnection",
      "type": "object"
    },
    "DeviceIdentifier": {
      "additionalProperties": false,
      "description": "Stable or diagnostic identifier attached to a device.",
      "properties": {
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DeviceIdentifier",
      "type": "object"
    },
    "DeviceRef": {
      "additionalProperties": false,
      "description": "Reference to a manager-local device in a hardware manager context.",
      "properties": {
        "deviceId": {
          "title": "Deviceid",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "managerId": {
          "title": "Managerid",
          "type": "string"
        }
      },
      "required": [
        "managerId",
        "deviceId"
      ],
      "title": "DeviceRef",
      "type": "object"
    },
    "DeviceSourceReference": {
      "additionalProperties": false,
      "description": "Diagnostic reference to a source descriptor, report, layout, or protocol fact.",
      "properties": {
        "connectionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connectionid"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Facts",
          "type": "object"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "type"
      ],
      "title": "DeviceSourceReference",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "dev.deckr.hardware.device_descriptor.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Descriptor for one controller-visible device or sub-surface.",
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDescriptor"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/DeviceConnection"
      },
      "title": "Connections",
      "type": "array"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlDescriptor"
      },
      "title": "Controls",
      "type": "array"
    },
    "defaultStatusIndicator": {
      "anyOf": [
        {
          "$ref": "#/$defs/DescriptorCapabilityRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deviceId": {
      "title": "Deviceid",
      "type": "string"
    },
    "displayName": {
      "title": "Displayname",
      "type": "string"
    },
    "fingerprint": {
      "title": "Fingerprint",
      "type": "string"
    },
    "firmwareVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Firmwareversion"
    },
    "hardwareVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hardwareversion"
    },
    "identifiers": {
      "items": {
        "$ref": "#/$defs/DeviceIdentifier"
      },
      "title": "Identifiers",
      "type": "array"
    },
    "manufacturer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manufacturer"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "modelId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modelid"
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "serialNumber": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Serialnumber"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/DeviceSourceReference"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "deviceId",
    "fingerprint",
    "displayName"
  ],
  "title": "Deckr DeviceDescriptor",
  "type": "object",
  "x-deckr-schema-version": "1"
}
