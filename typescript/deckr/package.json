{
  "name": "@deckr/core",
  "version": "0.3.0-dev.0",
  "private": true,
  "description": "TypeScript core contracts and lifecycle helpers for Deckr",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./beacon": {
      "types": "./dist/beacon.d.ts",
      "import": "./dist/beacon.js"
    },
    "./concord": {
      "types": "./dist/concord.d.ts",
      "import": "./dist/concord.js"
    },
    "./endpoint": {
      "types": "./dist/endpoint.d.ts",
      "import": "./dist/endpoint.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js"
    },
    "./lanes": {
      "types": "./dist/lanes.d.ts",
      "import": "./dist/lanes.js"
    },
    "./nats": {
      "types": "./dist/nats.d.ts",
      "import": "./dist/nats.js"
    },
    "./services": {
      "types": "./dist/services.d.ts",
      "import": "./dist/services.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "nats": "^2.29.0"
  },
  "peerDependenciesMeta": {
    "nats": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nats": "^2.29.3",
    "typescript": "^5.0.0"
  }
}
